# Photon sandbox (M2M) -- same org as the clinician app, so patients created
# here are visible there.
PHOTON_CLIENT_ID=your_photon_client_id
PHOTON_CLIENT_SECRET=your_photon_client_secret
PHOTON_ORG_ID=your_photon_org_id
PHOTON_AUDIENCE=https://api.neutron.health
PHOTON_TOKEN_URL=https://auth.neutron.health/oauth/token
PHOTON_API_URL=https://api.neutron.health/graphql

# Shared Postgres -- same value in the clinician app's .env.
DATABASE_URL=postgresql://localhost:5432/photon_ec

FLASK_SECRET_KEY=dev-secret-change-me
PORT=5000

# Used by catalog_agent.py: when a patient-typed allergy or medication name
# doesn't match Photon's catalog on the first try, an AI agent tries a few
# plausible alternate searches (misspelling, brand/generic swap) before
# giving up. Optional -- if unset, that step is silently skipped and the
# existing unresolved_allergies/unresolved_medications reporting behaves
# exactly as it did before this existed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
